# --- API (FastAPI) ---
# ENVIRONMENT=development
# ENVIRONMENT=production

# Panel de diagnóstico interno (/diagnostics/* + middleware de peticiones).
# En production / staging debe ser true explícitamente para exponer el API.
ENABLE_DIAGNOSTICS=false

# Desactiva por completo el módulo (404 en /diagnostics/* y sin registro en buffer).
DISABLE_DIAGNOSTICS=0

# Tamaño del ring buffer (peticiones, logs, errores en memoria).
DIAGNOSTICS_MAX_LOGS=500

# Versión mostrada en GET /diagnostics/health (opcional).
# APP_VERSION=1.0.0

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_API_URL=https://api.example.com
# Versión mostrada en el panel de diagnóstico (opcional).
# NEXT_PUBLIC_APP_VERSION=0.1.0
