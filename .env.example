# --- Bsale (scripts / jobs que llaman la API) ---
# BSALE_TOKEN=...
# BSALE_TOKEN_SPA=...   # alternativa si usan token distinto en su organización

# --- Auth JWT (FastAPI) ---
# OBLIGATORIO en producción (ENVIRONMENT=production). Mínimo 32 caracteres / bytes.
# Generar: openssl rand -hex 32
# JWT_SECRET_KEY=cambiar_por_clave_aleatoria_de_64_caracteres_hex_o_mas
# SECRET_KEY=...        # alias si JWT_SECRET_KEY no está definida

# --- Administración de usuarios (Etapa 2.1/2.2) — sin privilegios por defecto ---
# ENVIRONMENT debe ser production en Coolify. Vacío/desconocido = mutaciones denegadas.
# Propietario ERP (IDs de bsale.users). Vacío = nadie es OWNER.
# AUTH_OWNER_USER_IDS=123
# Sin AUTH_USER_ADMIN_EMAILS nadie puede mutar usuarios (salvo OWNER configurado).
# AUTH_USER_ADMIN_EMAILS=gerente@ejemplo.cl
# Quién puede asignar rol adm: OWNER, o GERENCIA listada aquí (nunca ADM).
# AUTH_ASSIGN_ADM_EMAILS=gerente@ejemplo.cl
# Solo si ENVIRONMENT=development|dev|local Y este flag=1: fallback adm local.
# Nunca activar en producción.
# AUTH_USER_ADMIN_DEV_FALLBACK=0
# Recuperación OWNER: docs/auth/OWNER_RECOVERY.md
# Rate limit del endpoint público de reset (por IP, ventana en segundos).
# AUTH_PASSWORD_RESET_RATE_LIMIT=20
# AUTH_PASSWORD_RESET_RATE_WINDOW_SEC=300

# --- API (FastAPI) ---
# ENVIRONMENT=development
# ENVIRONMENT=production

# Panel de diagnóstico interno (/diagnostics/* + middleware de peticiones).
# En production / staging debe ser true explícitamente para exponer el API.
ENABLE_DIAGNOSTICS=false

# Desactiva por completo el módulo (404 en /diagnostics/* y sin registro en buffer).
DISABLE_DIAGNOSTICS=0

# Tamaño del ring buffer (peticiones, logs, errores en memoria).
DIAGNOSTICS_MAX_LOGS=500

# Versión mostrada en GET /diagnostics/health (opcional).
# APP_VERSION=1.0.0

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_API_URL=https://api.example.com
# Versión mostrada en el panel de diagnóstico (opcional).
# NEXT_PUBLIC_APP_VERSION=0.1.0
