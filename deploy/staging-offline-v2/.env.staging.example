# Offline V2 — plantilla STAGING (NO producción)
# Copiar a .env.staging (gitignored). Nunca pegar secretos en el chat.

OFFLINE_V2_ENV_PROFILE=staging

# --- PostgreSQL SOLO staging/lab ---
# Debe ser 127.0.0.1 / host privado de lab. NUNCA analytics / api.quillotana.cl DNS.
STAGING_DATABASE_URL=postgresql://offline_v2_lab:CHANGE_ME@127.0.0.1:5433/offline_v2_lab
DATABASE_URL=${STAGING_DATABASE_URL}

# --- API ---
JWT_SECRET_KEY=CHANGE_ME_STAGING_ONLY_NOT_PROD
SECRET_KEY=${JWT_SECRET_KEY}
OFFLINE_SYNC_WRITES_ENABLED=false
# Kill switch: writes=false detiene escrituras de inmediato.
# OFFLINE_V2_ALLOW_WRITES_AT_BOOT=1   # solo cuando se activen writes a propósito

# --- PWA ---
# Build arg: URL pública del API staging (túnel o dominio controlado), NUNCA api.quillotana.cl
NEXT_PUBLIC_API_URL=https://REPLACE_STAGING_API_HOST
API_PROXY_TARGET=http://127.0.0.1:18080
OFFLINE_V2_LAB_ENABLED=0
OFFLINE_V2_LAB_GATE_TOKEN=
# Sync writes PWA: solo lab host no-quillotana; el backend manda.
NEXT_PUBLIC_OFFLINE_SYNC_WRITES=0
NEXT_PUBLIC_LAB_API_DIRECT=

# --- R2 SOLO lab ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lq-ops-lab-evidence
R2_ENDPOINT=

# --- Bsale ---
# Staging ficticio: NO configurar token productivo.
BSALE_TOKEN=
BSALE_TOKEN_SPA=
