# Build / runtime (Coolify: Base Directory = apps/pwa)
#
# Browser: mismo origen → /api-upstream (Route Handler en app/api-upstream).
# NEXT_PUBLIC_API_URL se usa solo para decidir si hace falta el proxy same-origin.
NEXT_PUBLIC_API_URL=https://api.quillotana.cl

# Runtime en contenedor Next (NO build arg): destino servidor→FastAPI.
# Preferir hostname Docker/Coolify interno verificado (mismo Docker network).
# NO usar localhost, IP Cloudflare ni IP pública fija.
# Ejemplo (reemplazar <nombre-interno-api> con el hostname real de Coolify):
# API_PROXY_TARGET=http://<nombre-interno-api>:8000
#
# Sin API_PROXY_TARGET el proxy cae a NEXT_PUBLIC_API_URL (DNS público → riesgo EAI_AGAIN).

# Puerto interno Coolify del contenedor PWA
# PORT=3000

# Grupo WhatsApp operativo (reportes reales). Solo invite autorizado.
# Si está vacío, la PWA usa wa.me/?text= (selector de chat).
# NUNCA poner aquí el enlace del grupo familiar de demostración.
# NEXT_PUBLIC_OPS_WHATSAPP_INVITE_URL=https://chat.whatsapp.com/...
